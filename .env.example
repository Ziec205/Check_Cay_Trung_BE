PORT=4000
# Chuỗi kết nối MongoDB Atlas (thay user, mật khẩu, cluster)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/trangtrai?retryWrites=true&w=majority
# Lấy tại https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Có thể bỏ trống. Nhiều model cách nhau bằng dấu phẩy, model sau là dự phòng.
GEMINI_MODEL=gemini-3.5-flash-lite,gemini-3.5-flash
# Mức suy nghĩ của model: low (mặc định), minimal, medium, high. Để trống để dùng mặc định của Google.
GEMINI_THINKING=low
# Địa chỉ web trên Vercel (nhiều địa chỉ cách nhau bằng dấu phẩy). Để * khi chạy thử.
CORS_ORIGIN=*
